# Database settings
DB_NAME=gallery_db
DB_USER=gallery_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# Telegram settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Strongly recommended: enables MTProto so files up to 2 GB can be stored and
# streamed (the Bot API alone caps uploads at 50 MB and downloads at 20 MB).
# Get both from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Django settings
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis / Celery settings
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# App security settings
MAX_UPLOAD_SIZE=2097152000
# Optional: separate key for signed media URLs (defaults to DJANGO_SECRET_KEY)
MEDIA_URL_SIGNING_KEY=
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# Azure Blob (temporary upload storage)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=temp-uploads

# Media processing
PREVIEW_MAX_SIDE=1600
# auto = make a streamable copy of videos browsers can't play smoothly; off = originals only
VIDEO_STREAM_VARIANTS=auto
VIDEO_STREAM_MAX_HEIGHT=1080
VIDEO_TRANSCODE_HEVC=False

# Database connection pool (per process)
DB_POOL_MAX=8

# Web server
GUNICORN_WORKERS=2
GUNICORN_THREADS=24
